FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    python3 \
    python3-pip \
    python3-venv \
    x11-apps \
    xauth \
    xvfb \
    dbus-x11 \
    libasound2 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnss3 \
    libx11-xcb1 \
    libxkbcommon0 \
    libxss1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/brotab

COPY requirements/ requirements/

RUN python3 -m pip install --upgrade pip \
    && pip install -r requirements/bdd.txt \
    && python3 -m playwright install --with-deps chromium

ENV PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright

# Build:
#   docker build -f Dockerfile.x11 -t brotab-x11 .
# Run with X11 passthrough (Linux host):
#   xhost +local:docker
#   docker run --rm -it \
#     -e DISPLAY=$DISPLAY \
#     -v /tmp/.X11-unix:/tmp/.X11-unix \
#     -v "$(pwd)":/workspace/brotab \
#     brotab-x11

CMD ["bash"]
